{
  "name": "ayeda-monorepo",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky || true",
    "lint": "eslint . --ext .ts,.js,.vue",
    "lint:fix": "eslint . --ext .ts,.js,.vue --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md,vue}\"",
    "storybook": "pnpm --filter storybook storybook"
  },
  "lint-staged": {
    "apps/backend/**/*.ts": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
