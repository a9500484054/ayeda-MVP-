{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "modulePaths": ["<rootDir>/.."],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.spec.json" }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(?:.*/)?(?:@nestjs/schedule|uuid)/)"
  ],
  "testTimeout": 30000
}
